{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundboard",
  "version": "1.0.0",
  "identifier": "io.github.ghuumiruma.soundboard",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Soundboard",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "useHttpsScheme": false,
        "acceptFirstMouse": true,
        "backgroundColor": "#111018",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "style-src-attr": "'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "publisher": "GhuumiRuma",
    "shortDescription": "Big colourful buttons for your sounds.",
    "longDescription": "Soundboard puts your sounds on big colourful buttons. Play them with a click or a key, even while another app is in front. Everything stays on your computer: no account, no cloud.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "./entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
